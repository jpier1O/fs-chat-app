# ===========================================
# Multi-Turn Chat Application - Environment Variables
# ===========================================

# Backend Configuration (NestJS)
# ===============================

# LLM Configuration - Google Gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash-exp

# Alternative environment variable names (for compatibility)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Redis (used by the NestJS session store)
REDIS_URL=redis://localhost:6379

# CORS — set to your Vercel frontend URL in production
# ALLOWED_ORIGIN=https://your-app.vercel.app

# Frontend Configuration (Next.js)
# =================================

# Backend API URL (used by Next.js Route Handlers)
API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Next.js Configuration
NODE_ENV=development

# ===========================================
# Setup Instructions:
# ===========================================
# 1. Copy this file to .env in both be/ and fe/ directories
# 2. Get your Gemini API key from: https://makersuite.google.com/app/apikey
# 3. Replace 'your_gemini_api_key_here' with your actual API key
# 4. Adjust URLs if running on different ports
# ===========================================